# EraseOps local configuration. Copy to `.env`; the API loads it on start.
# Never place production credentials in this file.

# --- API server ---
API_PORT=3001
CORS_ORIGIN=*
DEMO_MODE=true

# mock  = in-memory synthetic dataset (no Docker needed, fully stateful)
# local = real PostgreSQL + MinIO from `docker compose up -d`
CONNECTOR_MODE=mock
# Optional: point the mock connectors at your own dataset fixture
# ERASEOPS_DATASET_FILE=infra/fixtures/demo-dataset.json

# --- Safety controls ---
ALLOWLIST_SYSTEMS=PostgreSQL,MinIO
ALLOWLIST_HOSTS=postgres
ALLOWLIST_BUCKETS=customer-uploads,support-attachments,exports,eraseops-backups
APPROVAL_TTL_MINUTES=15
DESTRUCTIVE_RATE_LIMIT=3
DESTRUCTIVE_RATE_WINDOW_SECONDS=60

# --- Agents ---
# With a key, OpenAI runs the LangGraph agents and reads natural-language commands.
# Without one, the same agents run on deterministic rules.
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-5.5
# Alternative provider, used when no OpenAI key is set:
# ANTHROPIC_API_KEY=sk-ant-...
ERASEOPS_AI=auto
ERASEOPS_MODEL=claude-opus-5-5

# --- Persistence (memory | postgres) ---
ERASEROPS_PERSISTENCE=memory

# --- Local infrastructure (matches docker-compose.yml) ---
DATABASE_URL=postgres://eraseops:eraseops_local_only@localhost:5432/eraseops
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=eraseops
MINIO_SECRET_KEY=eraseops_local_only

# --- Python backend (pydantic-settings, ERASEOPS_ prefix) ---
ERASEOPS_DATABASE_URL=postgresql+psycopg://eraseops:eraseops_local_only@localhost:5432/eraseops
