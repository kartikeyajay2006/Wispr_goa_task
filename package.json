{
  "name": "eraserops",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm run dev:api\" \"npm run dev:web\"",
    "dev:api": "ERASEROPS_START_SERVER=true tsx apps/api/src/server.ts",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:mcp": "ERASEROPS_MCP_STDIO=true tsx apps/mcp-server/src/stdio.ts",
    "build": "tsc -b && vite build --config apps/web/vite.config.ts",
    "test": "vitest run",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^9.0.0",
    "express": "^5.0.0",
    "picomatch": "^2.3.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "@types/pg": "^8.23.1",
    "@vitejs/plugin-react": "^4.3.0",
    "cors": "^2.8.5",
    "express": "^5.0.0",
    "framer-motion": "^14.0.0",
    "lucide-react": "^1.52.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "reactflow": "^11.11.4",
    "recharts": "^3.10.1",
    "zod": "^3.23.8",
    "zustand": "^5.0.15"
  }
}
